# =============================================================================
# Variáveis de ambiente — copie para .env (local) ou cadastre no Railway.
# NUNCA versione valores reais. Campos vazios = recurso desativado.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# 1 apenas em desenvolvimento local
DJANGO_DEBUG=0
# Domínios separados por vírgula (o domínio *.up.railway.app é incluído automaticamente)
DJANGO_ALLOWED_HOSTS=sualoja.com.br,www.sualoja.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://sualoja.com.br,https://www.sualoja.com.br
# URL pública usada em e-mails, webhooks e retornos de pagamento (com https)
SITE_URL=https://sualoja.com.br
DJANGO_HSTS_SECONDS=2592000
LOG_LEVEL=INFO

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# No Railway use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- Mercado Pago (Checkout Pro) ---------------------------------------------
# sandbox | production
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Assinatura secreta exibida em "Suas integrações > Webhooks" no painel do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MAX_INSTALLMENTS=6
# Somente desenvolvimento: permite registrar pedidos sem gateway (nunca são marcados como pagos)
ALLOW_ORDERS_WITHOUT_GATEWAY=0
# Minutos de reserva de estoque aguardando pagamento
STOCK_RESERVATION_MINUTES=60

# --- Armazenamento S3-compatible (Railway Bucket, Cloudflare R2, AWS S3...) ---
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# virtual | path (alguns provedores exigem path)
S3_ADDRESSING_STYLE=virtual
# Bucket privado (padrão Railway): imagens públicas servidas com URL assinada de longa duração
S3_PUBLIC_MEDIA_SIGNED=1
S3_PUBLIC_URL_EXPIRE=518400
# Opcional: domínio de CDN para mídia pública (desative S3_PUBLIC_MEDIA_SIGNED se o bucket for público)
S3_CUSTOM_DOMAIN=
# Alternativa sem S3: Railway Volume montado em MEDIA_ROOT
MEDIA_ROOT=
SERVE_MEDIA_FROM_DISK=0
PERSONALIZATION_MAX_UPLOAD_MB=10
PRODUCT_IMAGE_MAX_UPLOAD_MB=12

# --- E-mail (SMTP) -----------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Loja <nao-responda@sualoja.com.br>

# --- Administrador inicial (opcional) ------------------------------------------
# Criado na inicialização se ainda não existir. Usuário existente nunca é alterado.
# Apague DJANGO_SUPERUSER_PASSWORD depois do primeiro acesso.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FULL_NAME=

# --- Loja --------------------------------------------------------------------
# Valores iniciais; depois edite no painel (Marca)
STORE_NAME=NOME DA MARCA
# CEP de origem para cotação de frete (somente números)
STORE_ORIGIN_ZIPCODE=
STORE_WHATSAPP=
STORE_INSTAGRAM=

# --- Frete: Melhor Envio -----------------------------------------------------
MELHORENVIO_TOKEN=
# sandbox | production
MELHORENVIO_ENVIRONMENT=sandbox
# Exigido pela API: "Nome da loja (email-de-contato@dominio)"
MELHORENVIO_USER_AGENT=

# --- Segurança / desempenho ----------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900
# Opcional: cache compartilhado entre réplicas (recomendado com mais de 1 instância)
REDIS_URL=
WEB_CONCURRENCY=3
